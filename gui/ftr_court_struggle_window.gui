# 朝堂局势窗口 —— 分层展示朝廷权力格局。
# 数据源：玩家域变量列表（由 ftr_court_sync_ui_data 镜像）。
# 布局：君主[+摄政] 及其支持者 → 摄政权势平衡条 → 权臣/内阁 → 继任者（参与角逐者）及其支持者。
window = {
	name = "ftr_court_struggle_window"
	parentanchor = center
	size = { 760 900 }
	position = { 0 0 }
	layer = windows_layer
	visible = "[GetVariableSystem.Exists( 'ftr_court_struggle_window_open' )]"
	using = Window_Background
	using = Window_Decoration

	margin_widget = {
		size = { 100% 100% }
		margin = { 10 26 }
		margin_right = 13
		widget = {
			size = { 100% 100% }
			vbox = {
				using = Window_Margins

				# ==================== 顶部背景区（图片作为背景，标题叠加其上，节省空间） ====================
				widget = {
					size = { 100% 140 }
					layoutpolicy_horizontal = expanding
					background = {
						fittype = centercrop
						texture = "gfx/interface/illustrations/window_headers/header_military.dds"
						modify_texture = {
							texture = "gfx/interface/illustrations/window_headers/mask_header_illustration.dds"
							blend_mode = alphamultiply
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 8 6 }
						expand = {}
						text_single = {
							text = "ftr_court_ui_title"
							fontsize = 20
						}
						expand = {}
					}
					button_close = {
						size = { 30 30 }
						parentanchor = top|right
						margin_right = 12
						margin_top = 8
						onclick = "[GetVariableSystem.Clear('ftr_court_struggle_window_open')]"
					}
				}

				# ==================== 1. 君主 + 共治者 + 平衡条（居中） ====================
				widget = {
					margin_top = 12
					margin_bottom = 12
					layoutpolicy_horizontal = expanding
					size = { 100% 120 }
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 14
						expand = {}
						# 最高统治者头像
						portrait_head_small = {
							name = "player_head_portrait"
							visible = "[Character.IsValid]"
							datacontext = "[GetPlayer.MakeScope.Var('ftr_court_ui_monarch_char').Char]"
						}
						# 摄政权势平衡条
						vbox = {
							layoutpolicy_horizontal = fixed
							progressbar = {
								size = { 300 14 }
								min = 0
								max = 100
								value = "[GetPlayer.MakeScope.Var('ftr_court_ui_swing').GetValue]"
								progresstexture = "gfx/interface/progressbars/progress_blue.dds"
								noprogresstexture = "gfx/interface/progressbars/progress_blue_bg.dds"
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								text_single = { text = "FTR_COURT_SWING_LOYAL" }
								expand = {}
								text_single = { text = "FTR_COURT_SWING_DIARCH" }
							}
						}
						# 共治者头像（常驻；无共治者时角色变量无效显示为空）
						portrait_head_small = {
							name = "regent_head_portrait_my"
							datacontext = "[GetPlayer.MakeScope.Var('ftr_court_ui_diarch_char').Char]"
						}
						expand = {}
					}
				}

				# ==================== 列表区（可滚动） ====================
				scrollbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					blockoverride "scrollbox_content"
					{
						vbox = {
							layoutpolicy_horizontal = expanding

							# ==================== 2. 君主与共治者的支持者 ====================
							hbox = {
								layoutpolicy_horizontal = expanding
								# 君主支持者
								vbox = {
									layoutpolicy_horizontal = expanding
									text_single = {
										margin = { 10 8 }
										text = "ftr_court_ui_monarch_backers_label"
									}
									hbox = {
										layoutpolicy_horizontal = expanding
										scrollbox = {
											layoutpolicy_horizontal = expanding
											blockoverride "scrollbox_content"
											{
												hbox = {
													margin = { 10 0 }
													spacing = 12
													datamodel = "[GetPlayer.MakeScope.GetList('ftr_court_ui_monarch_backers')]"
													layoutpolicy_horizontal = fixed
													item = {
														ftr_court_small_icon = {
															datacontext = "[CharacterListItem.GetCharacter]"
														}
													}
												}
											}
										}
										expand = {}
									}
								}
								
								# 共治者支持者
								vbox = {
									layoutpolicy_horizontal = expanding
									text_single = {
										margin = { 10 8 }
										visible = "[GetPlayer.MakeScope.Var('ftr_court_ui_has_diarch').IsEqual('1')]"
										text = "ftr_court_ui_diarch_backers_label"
									}
									hbox = {
										layoutpolicy_horizontal = expanding
										scrollbox = {
											layoutpolicy_horizontal = expanding
											blockoverride "scrollbox_content"
											{
												hbox = {
													margin = { 10 0 }
													spacing = 12
													visible = "[GetPlayer.MakeScope.Var('ftr_court_ui_has_diarch').IsEqual('1')]"
													datamodel = "[GetPlayer.MakeScope.GetList('ftr_court_ui_diarch_backers')]"
													layoutpolicy_horizontal = fixed
													item = {
														ftr_court_small_icon = {
															datacontext = "[CharacterListItem.GetCharacter]"
														}
													}
												}
											}
										}
										expand = {}
									}
								}
							}

							# ==================== 3. 继任者（参与角逐者）及其支持者 ====================
							text_single = {
								margin = { 10 14 }
								text = "ftr_court_ui_heirs_label"
							}
							# 暂无参与者时的占位提示（有朝堂 story 但参与者为 0）
							text_single = {
								margin = { 20 4 }
								text = "ftr_court_ui_no_claimants"
								visible = "[And(GetPlayer.MakeScope.Var('ftr_court_ui_active').IsEqual('1'), GetPlayer.MakeScope.Var('ftr_court_ui_count').IsEqual('0'))]"
							}
							# 每个继任者一行：vbox { hbox { 继任者头像 + hbox{该继任者的支持者} + 空白 } }
							# 数据源：ftr_court_ui_claimants（由 ftr_court_sync_ui_from_story_effect 从 story 的 ftr_court_participant_list 同步）
							vbox = {
								margin = { 20 20 }
								spacing = 12
								layoutpolicy_horizontal = expanding
								datamodel = "[GetPlayer.MakeScope.GetList('ftr_court_ui_claimants')]"
								item = {
									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 8
										ftr_court_small_icon = {
											layoutpolicy_horizontal = fixed
											datacontext = "[CharacterListItem.GetCharacter]"
										}
										hbox = {
											spacing = 6
											text_single = {
												text = "ftr_court_ui_backers_label"
												fontsize = 11
												alpha = 0.7
											}
											scrollbox = {
												layoutpolicy_horizontal = expanding
												blockoverride "scrollbox_content"
												{
													hbox = {
														spacing = 6
														datamodel = "[CharacterListItem.GetCharacter.MakeScope.GetList('ftr_court_heir_backers')]"
														layoutpolicy_horizontal = expanding
														item = {
															ftr_court_small_icon = {
																layoutpolicy_horizontal = fixed
																datacontext = "[CharacterListItem.GetCharacter]"
															}
														}
													}
												}
											}
										}
										expand = {}
									}
								}
							}

						}
					}
				}
			}
		}
	}
}

# ==================== 模板 ====================
types Lists
{
	# 小图标（权臣/内阁/继任者/支持者通用，仅头像）
	# fixedgridbox 网格中头像居中于格子；hbox 列表中多个头像靠左排列、间距由 hbox 的 spacing 控制。
	type ftr_court_small_icon = vbox {
		datacontext = "[Scope.GetCharacter]"
		layoutpolicy_horizontal = expanding
		portrait_head_small = {
			size = { 64 64 }
		}
	}
}
