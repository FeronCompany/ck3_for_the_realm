# 朝堂局势窗口 —— 分层展示朝廷权力格局。
# 数据源：玩家域变量列表（由 ftr_court_sync_ui_data 镜像）。
# 布局：君主[+摄政]居中 → 摄政权势平衡条 → 配偶/姬妾 → 权臣/内阁 → 继任者 → 追随者。
window = {
	name = "ftr_court_struggle_window"
	parentanchor = center
	size = { 760 900 }
	position = { 0 0 }
	layer = windows_layer
	visible = "[GetVariableSystem.Exists( 'ftr_court_struggle_window_open' )]"
	using = Window_Background
	using = Window_Decoration

	margin_widget = {
		size = { 100% 100% }
		margin = { 10 26 }
		margin_right = 13
		widget = {
			size = { 100% 100% }
			vbox = {
				using = Window_Margins

				# ==================== 顶部背景区（图片作为背景，标题叠加其上，节省空间） ====================
				# CK3 支持 background + 叠加内容（原版 widget_header_with_picture 同款机制）：
				# 图片铺满顶部横幅区域作为背景，标题/关闭按钮叠加其上，不再有独立的文字条 + 图片块。
				# 注：header 插图是横向横幅图，若强行铺满窗口 1/3 高度会严重放大失真，故采用横幅比例背景。
				widget = {
					size = { 100% 140 }
					layoutpolicy_horizontal = expanding
					# ---- 背景图片 ----
					background = {
						fittype = centercrop
						texture = "gfx/interface/illustrations/window_headers/header_military.dds"
						modify_texture = {
							texture = "gfx/interface/illustrations/window_headers/mask_header_illustration.dds"
							blend_mode = alphamultiply
						}
					}
					# ---- 叠加：标题（水平居中）+ 关闭按钮（右上角） ----
					hbox = {
						layoutanchor = topleft
						layoutpolicy_horizontal = expanding
						margin = { 8 6 8 0 }
						# 左右 expand 对称，让标题水平居中
						expand = {}
						text_single = {
							text = "ftr_court_ui_title"
							fontsize = 20
						}
						expand = {}
					}
					button_close = {
						size = { 30 30 }
						parentanchor = top|right
						margin = { 0 8 12 0 }
						onclick = "[GetVariableSystem.Clear('ftr_court_struggle_window_open')]"
					}
				}

				# ==================== 1. 君主 + 摄政 + 平衡条（居中，固定高度避免遮挡） ====================
				# 结构：hbox { 最高统治者头像 + 摄政权势平衡条 + 共治者头像 }（单行，平衡条在头像之间）
				# 共治者头像位置常驻：有摄政/共治者显示头像，无则显示空位。
				# 平衡条始终显示，置于君主与摄政头像之间以节省垂直空间。
				# 头像 tooltip：portrait_head_small 模板内置 character_tooltip（portrait_base），
				# 不要在此手动 using = character_tooltip，否则可能干扰内置行为。
				widget = {
					margin = { 0 12 }
					layoutpolicy_horizontal = expanding
					size = { 100% 120 }
					hbox = {
						layoutanchor = topleft
						layoutpolicy_horizontal = expanding
						spacing = 14
						# 左占位，让下方内容组水平居中
						expand = {}
						# 最高统治者头像
						portrait_head_small = {
							name = "player_head_portrait"
							visible = "[Character.IsValid]"
							datacontext = "[GetPlayer.MakeScope.Var('ftr_court_ui_monarch_char').Char]"
						}
						# 摄政权势平衡条（位于君主与摄政头像之间，节省独立行的垂直空间）
						vbox = {
							layoutpolicy_horizontal = fixed
							layoutanchor = topleft
							progressbar = {
								size = { 300 14 }
								# swing 取值范围为 -100（忠于君主）~ 100（倒向共治），
								# 用 min/max 让 value 线性映射到条上：0 显示在中点（平衡）。
								min = -100
								max = 100
								value = "[GetPlayer.MakeScope.Var('ftr_court_ui_swing').GetValue]"
								# progresstexture（有进度）/ noprogresstexture（无进度）保证 value=0 时条仍可见
								progresstexture = "gfx/interface/progressbars/progress_blue.dds"
								noprogresstexture = "gfx/interface/progressbars/progress_blue_bg.dds"
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								text_single = { text = "FTR_COURT_SWING_LOYAL" }
								expand = {}
								text_single = { text = "FTR_COURT_SWING_DIARCH" }
							}
						}
						# 共治者头像（常驻；无共治者时角色变量无效显示为空）
						portrait_head_small = {
							name = "regent_head_portrait_my"
							datacontext = "[GetPlayer.MakeScope.Var('ftr_court_ui_diarch_char').Char]"
						}
						# 右占位，让下方内容组水平居中
						expand = {}
					}
				}

				# ==================== 列表区（可滚动，避免内容溢出显示不全） ====================
				scrollbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					blockoverride "scrollbox_content"
					{
						vbox = {
							layoutpolicy_horizontal = expanding

							# ==================== 2. 权臣 / 内阁 ====================
							text_single = {
								margin = { 10 14 10 4 }
								text = "ftr_court_ui_ministers_label"
							}
							scrollbox = {
								name = "memeber_list"
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding
								blockoverride "scrollbox_content"
								{
									hbox = {
										margin = { 10 0 }
										spacing = 12
										datamodel = "[GetPlayer.MakeScope.GetList('ftr_court_ui_ministers')]"
										layoutpolicy_horizontal = no
										layoutanchor = topleft
										item = {
											ftr_court_small_icon = {
												datacontext = "[CharacterListItem.GetCharacter]"
											}
										}
									}
									expand = {}
								}
							}

							# ==================== 3. 配偶 / 姬妾 ====================
							text_single = {
								margin = { 10 14 10 4 }
								text = "ftr_court_ui_spouses_label"
							}
							scrollbox = {
								name = "spouse_list"
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding
								blockoverride "scrollbox_content"
								{
									hbox = {
										margin = { 10 0 }
										spacing = 12
										datamodel = "[GetPlayer.MakeScope.GetList('ftr_court_ui_spouses')]"
										layoutpolicy_horizontal = no
										layoutanchor = topleft
										item = {
											ftr_court_small_icon = {
												datacontext = "[CharacterListItem.GetCharacter]"
											}
										}
									}
									expand = {}
								}
							}

							# ==================== 4. 继任者 ====================
							text_single = {
								margin = { 10 14 10 4 }
								text = "ftr_court_ui_heirs_label"
							}
							fixedgridbox = {
								margin = { 10 0 }
								addcolumn = 90
								addrow = 100
								datamodel_wrap = 4
								flipdirection = yes
								setitemsizefromcell = yes
								layoutanchor = topleft
								datamodel = "[GetPlayer.MakeScope.GetList('ftr_court_ui_heirs')]"
								item = {
									ftr_court_small_icon = {
										datacontext = "[CharacterListItem.GetCharacter]"
									}
								}
							}

							# ==================== 5. 追随者（有 story 时） ====================
							text_single = {
								margin = { 10 14 10 4 }
								text = "ftr_court_ui_backers_label"
								visible = "[NotZero_CFixedPoint( GetPlayer.MakeScope.Var('ftr_court_ui_active').GetValue )]"
							}
							fixedgridbox = {
								margin = { 10 0 }
								addcolumn = 90
								addrow = 100
								datamodel_wrap = 4
								flipdirection = yes
								setitemsizefromcell = yes
								layoutanchor = topleft
								datamodel = "[GetPlayer.MakeScope.GetList('ftr_court_ui_backers')]"
								visible = "[NotZero_CFixedPoint( GetPlayer.MakeScope.Var('ftr_court_ui_active').GetValue )]"
								item = {
									ftr_court_small_icon = {
										datacontext = "[CharacterListItem.GetCharacter]"
									}
								}
							}

						}
					}
				}
			}
		}
	}
}

# ==================== 模板 ====================
types Lists
{
	# 小图标（配偶/姬妾/权臣/内阁/继任者/追随者通用，仅头像）
	# 列表容器负责整体靠左；此处 vbox 撑满格子、头像在格子内水平居中。
	# fixedgridbox 网格中头像居中于格子；hbox 列表中多个头像靠左排列、间距由 hbox 的 spacing 控制。
	type ftr_court_small_icon = vbox {
		datacontext = "[Scope.GetCharacter]"
		layoutpolicy_horizontal = expanding
		layoutanchor = topleft
		portrait_head_small = {
			size = { 64 64 }
			tooltip_enabled = "[Character.IsValid]"
			using = character_tooltip
		}
	}
}
