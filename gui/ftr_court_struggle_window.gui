# 朝堂局势窗口 —— 分层展示朝廷权力格局。
# 数据源：各权贵角色身上的主存储列表。
#   - 君主支持者 / 参与者列表：最高统治者（GetPlayer.GetTopLiege）身上的 ftr_court_supporters / ftr_court_claimants
#   - 共治者支持者：共治者身上的 ftr_court_supporters
#   - 参与者支持者：各参与者身上的 ftr_court_supporters
# 布局：君主[+摄政] 及其支持者 → 摄政权势平衡条 → 权臣/内阁 → 继任者（参与角逐者）及其支持者。
window = {
	name = "ftr_court_struggle_window"
	parentanchor = center
	size = { 760 900 }
	position = { 0 0 }
	layer = windows_layer
	visible = "[GetVariableSystem.Exists( 'ftr_court_struggle_window_open' )]"
	using = Window_Background
	using = Window_Decoration

	margin_widget = {
		size = { 100% 100% }
		margin = { 10 26 }
		margin_right = 13
		widget = {
			size = { 100% 100% }
			vbox = {
				using = Window_Margins

				# ==================== 顶部背景区（图片作为背景，标题叠加其上，节省空间） ====================
				widget = {
					size = { 100% 140 }
					layoutpolicy_horizontal = expanding
					background = {
						fittype = centercrop
						texture = "gfx/interface/illustrations/window_headers/header_military.dds"
						modify_texture = {
							texture = "gfx/interface/illustrations/window_headers/mask_header_illustration.dds"
							blend_mode = alphamultiply
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						# 第一行：标题"朝堂局势"在上居中
						hbox = {
							layoutpolicy_horizontal = expanding
							margin = { 8 6 }
							margin_bottom = 0
							expand = {}
							text_single = {
								text = "ftr_court_ui_title"
								fontsize = 20
							}
							expand = {}
						}
						# 第二行：功勋录按钮在下靠左（先置弹窗开关，再重建名单刷新数据）
						hbox = {
							layoutpolicy_horizontal = expanding
							margin_left = 8
							margin_bottom = 6
							button_standard_clean = {
								name = "ftr_court_open_merit_button"
								size = { 132 22 }
								tooltip = "ftr_court_merit_list_tooltip"
								onclick = "[GetVariableSystem.Set( 'ftr_personal_merit_window_open', 'true' )]"
								onclick = "[GetScriptedGui('ftr_personal_merit_sync_ui').Execute( GuiScope.SetRoot( GetPlayer.GetTopLiege.MakeScope ).End )]"
								text_single = {
									text = "ftr_court_merit_list_button"
									fontsize = 12
								}
							}
							expand = {}
						}
					}
					button_close = {
						size = { 30 30 }
						parentanchor = top|right
						margin_right = 12
						margin_top = 8
						onclick = "[GetVariableSystem.Clear('ftr_court_struggle_window_open')]"
					}
				}

				# ==================== 1. 君主 + 共治者 + 平衡条（居中） ====================
				widget = {
					margin = { 0 12 }
					layoutpolicy_horizontal = expanding
					size = { 100% 120 }
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 14
						expand = {}
						# 最高统治者头像
						portrait_head_small = {
							name = "player_head_portrait"
							visible = "[Character.IsValid]"
							datacontext = "[GetPlayer.GetTopLiege]"
						}
						# 摄政权势平衡条
						vbox = {
							layoutpolicy_horizontal = fixed
							progressbar = {
								size = { 300 14 }
								min = 0
								max = 100
								value = "[GetPlayer.GetTopLiege.MakeScope.ScriptValue( 'ftr_get_diarchy_swing' )]"
								progresstexture = "gfx/interface/progressbars/progress_blue.dds"
								noprogresstexture = "gfx/interface/progressbars/progress_blue_bg.dds"
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								text_single = { text = "FTR_COURT_SWING_LOYAL" }
								expand = {}
								text_single = { text = "FTR_COURT_SWING_DIARCH" }
							}
						}
						# 共治者头像（常驻；无共治者时角色变量无效显示为空）
						portrait_head_small = {
							name = "regent_head_portrait_my"
							datacontext = "[GetPlayer.GetTopLiege.GetDiarchy.GetDiarch]"
						}
						expand = {}
					}
				}

				# ==================== 列表区（可滚动） ====================
				scrollbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					blockoverride "scrollbox_content"
					{
						vbox = {
							layoutpolicy_horizontal = expanding

							# ==================== 2. 君主与共治者的支持者 ====================
							hbox = {
								layoutpolicy_horizontal = expanding
								# 两栏等宽：minimumsize 50% 强制均分——否则 expanding 会按内容最小宽分配，
								# 支持者多的一栏（fixedgridbox 更宽）会挤占另一栏，出现左右不等宽。
								spacing = 0
								# 君主支持者
								vbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									minimumsize = { 50% 0 }
									text_single = {
										margin = { 10 8 }
										text = "ftr_court_ui_monarch_backers_label"
										margin_bottom = 30
									}
									ftr_court_supporter_grid = {
										datacontext = "[GetPlayer.GetTopLiege]"
									}
									expand = {}
								}
								
								# 共治者支持者（与君主栏等宽；无共治者时支持者列表为空）
								vbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									minimumsize = { 50% 0 }
									text_single = {
										margin = { 10 8 }
										text = "ftr_court_ui_diarch_backers_label"
										margin_bottom = 30
									}
									ftr_court_supporter_grid = {
										datacontext = "[GetPlayer.GetTopLiege.GetDiarchy.GetDiarch]"
									}
									expand = {}
								}
							}

							# ==================== 3. 继任者（参与角逐者）及其支持者 ====================
							text_single = {
								margin = { 10 14 }
								text = "ftr_court_ui_heirs_label"
							}
							# 每个继任者一行 = 模板 ftr_court_claimant_row（继任者头像 + 该继任者的支持者）
							vbox = {
								margin = { 20 20 }
								spacing = 24
								layoutpolicy_horizontal = expanding
								datamodel = "[GetPlayer.GetTopLiege.MakeScope.GetList('ftr_court_claimants')]"
								item = {
									ftr_court_claimant_row = {
										datacontext = "[CharacterListItem.GetCharacter]"
									}
								}
							}

						}
					}
				}
			}
		}
	}
}

# ==================== 个人功勋名单窗口 ====================
# 已迁移至独立文件 gui/ftr_personal_merit_window.gui（ftr_personal_merit_window + 行模板），
# 由朝堂窗口左下"功勋录"按钮通过 UI 变量 ftr_personal_merit_window_open 开关。

# ==================== 模板 ====================
types Lists
{
	# 小图标（权臣/内阁/继任者/支持者通用，仅头像）
	# fixedgridbox 网格中头像居中于格子；hbox 列表中多个头像靠左排列、间距由 hbox 的 spacing 控制。
	type ftr_court_small_icon = vbox {
		datacontext = "[Scope.GetCharacter]"
		layoutpolicy_horizontal = expanding
		portrait_head_small = {
			size = { 64 64 }
		}
	}

	# 支持者名单网格：背景板 + fixedgridbox（头像 64×64，自动换行）。
	# 权贵支持者名单的通用呈现：claimant_row 的右半部分；也可单独用于
	# 君主 / 共治者支持者栏（不显示权贵头像），datacontext 直接传权贵即可。
	# 每行个数 / 单元格宽走 block "supporter_grid_cells"：
	#   默认（君主 / 共治者两栏并排）= 4 列 × 72 = 288，必须 ≤ 半栏宽，
	#   否则 fixedgridbox 的最小内容宽会把该栏撑宽，破坏两栏等宽；
	#   claimant_row（通栏行）用 blockoverride 还原为 6 列 × 80 = 480（原宽）。
	type ftr_court_supporter_grid = hbox {
		datacontext = "[Scope.GetCharacter]"
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = growing
		background = {
			using = Background_Area_Solid
			margin = { 10 0 }
			margin_top = 20
		}
		fixedgridbox = {
			addrow = 90
			datamodel = "[Character.MakeScope.GetList('ftr_court_supporters')]"
			flipdirection = yes
			block "supporter_grid_cells" {
				addcolumn = 72
				datamodel_wrap = 4
			}
			item = {
				container = {
					datacontext = "[Scope.Char]"
					portrait_head_small = {
						size = { 64 64 }
					}
				}
			}
		}
		expand = {}
	}

	# 继任者（参与角逐者）一行：左侧该继任者头像，右侧其支持者网格。
	# 用法：作为「参与者列表」datamodel 的 item（datacontext 由外层列表提供，
	# 通过 CharacterListItem.GetCharacter 取得当前参与者，再读其 ftr_court_supporters）。
	type ftr_court_claimant_row = hbox {
		datacontext = "[Scope.GetCharacter]"
		layoutpolicy_horizontal = expanding
		spacing = 8
		ftr_court_small_icon = {
			layoutpolicy_horizontal = fixed
			datacontext = "[Character]"
		}
		ftr_court_supporter_grid = {
			datacontext = "[Character]"
			# 竞争者党羽栏：保持原宽（6 列 × 80 = 480），与上半区的 4 列 × 72 不同
			blockoverride "supporter_grid_cells" {
				addcolumn = 80
				datamodel_wrap = 6
			}
		}
		
	}

	# 功勋名单行：已随功勋窗口迁至 gui/ftr_personal_merit_window.gui
}
